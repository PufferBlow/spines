{
  "color": {
    "--color-background": "#0a0a0a",
    "--color-background-secondary": "#121212",
    "--color-background-tertiary": "#161616",
    "--color-surface": "#161616",
    "--color-surface-secondary": "#1f1f1f",
    "--color-surface-tertiary": "#2a2a2a",
    "--color-text": "#f2f2f2",
    "--color-text-secondary": "#e0e0e0",
    "--color-text-tertiary": "#9a9a9a",
    "--color-text-muted": "#707070",
    "--color-border": "rgba(242, 242, 242, 0.14)",
    "--color-border-secondary": "rgba(242, 242, 242, 0.08)",
    "--color-primary": "#ffffff",
    "--color-primary-hover": "#e6e6e6",
    "--color-secondary": "#9a9a9a",
    "--color-secondary-hover": "#f2f2f2",
    "--color-accent": "#ffffff",
    "--color-accent-hover": "#e6e6e6",
    "--color-success": "#9fd487",
    "--color-warning": "#e6c15c",
    "--color-error": "#e2654f",
    "--color-info": "#8cc9d6",
    "--color-text-body": "#dadada",
    "--color-text-faint": "#555555",
    "--color-error-text": "#ef8a75",
    "--color-id-brass": "#e3ae4f",
    "--color-id-coral": "#ec8a6f",
    "--color-id-rose": "#e59ac0",
    "--color-id-violet": "#a99cf2",
    "--color-id-sky": "#7fc0e3",
    "--color-id-sage": "#9fcf8a",
    "--color-in-game": "#9fd487",
    "--color-hover": "#1f1f1f",
    "--color-active": "#2a2a2a",
    "--color-focus": "#ffffff",
    "--color-on-primary": "#000000",
    "--color-on-secondary": "#000000",
    "--color-on-accent": "#000000",
    "--color-on-success": "#000000",
    "--color-on-warning": "#000000",
    "--color-on-error": "#ffffff",
    "--color-on-info": "#000000",
    "--color-shadow-base": "rgba(0, 0, 0, 0.22)",
    "--color-shadow-strong": "rgba(0, 0, 0, 0.34)"
  },
  "radius": {
    "--radius-xs": "6px",
    "--radius-sm": "8px",
    "--radius-md": "10px",
    "--radius-lg": "14px",
    "--radius-xl": "18px",
    "--radius-2xl": "24px",
    "--radius-pill": "999px"
  },
  "shadow": {
    "--shadow-popover": "0 8px 24px var(--color-shadow-base)",
    "--shadow-modal": "0 18px 42px var(--color-shadow-strong)"
  },
  "font": {
    "--font-sans": "\"Barlow\", ui-sans-serif, system-ui, sans-serif, \"Noto Color Emoji\", \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\"",
    "--font-display": "\"Marcellus\", Georgia, serif",
    "--font-heading": "\"Barlow Condensed\", \"Barlow\", system-ui, sans-serif",
    "--font-mono": "\"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", \"SF Mono\", Monaco, Inconsolata, \"Roboto Mono\", \"Source Code Pro\", monospace"
  },
  "motion": {
    "--motion-fast": "120ms",
    "--motion-base": "200ms",
    "--motion-slow": "220ms",
    "--motion-puff": "500ms",
    "--motion-ease-out": "cubic-bezier(0.2, 0.8, 0.3, 1)",
    "--motion-ease-puff": "cubic-bezier(0.45, 0, 0.3, 1)"
  },
  "pb": {
    "--pb-bg": "var(--color-background)",
    "--pb-panel": "var(--color-background-secondary)",
    "--pb-surface": "var(--color-surface)",
    "--pb-raised": "var(--color-surface-secondary)",
    "--pb-active": "var(--color-surface-tertiary)",
    "--pb-line": "var(--color-border-secondary)",
    "--pb-text-1": "var(--color-text)",
    "--pb-text-2": "var(--color-text-tertiary)",
    "--pb-text-3": "var(--color-text-muted)",
    "--pb-text-4": "var(--color-text-faint)",
    "--pb-text-body": "var(--color-text-body)",
    "--pb-on-light": "var(--color-on-primary)",
    "--pb-danger": "var(--color-error)",
    "--pb-danger-text": "var(--color-error-text)",
    "--pb-warn": "var(--color-warning)",
    "--pb-in-game": "var(--color-in-game)",
    "--pb-glass": "rgba(10, 10, 10, 0.72)",
    "--pb-font-display": "var(--font-display)",
    "--pb-font-label": "var(--font-heading)",
    "--pb-font-body": "var(--font-sans)",
    "--pb-font-mono": "\"JetBrains Mono\", ui-monospace, Menlo, monospace",
    "--pb-focus": "0 0 0 2px var(--pb-panel), 0 0 0 4px var(--pb-text-1)"
  },
  "other": {
    "--message-font-size": "14px",
    "--message-group-gap": "1rem",
    "--message-row-padding-y": "0.25rem"
  }
}
